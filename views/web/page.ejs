<!--
  custom-pages custom page front-end rendering (reusing the site web
  layout).

  @since 1.0.0
-->
<article class="lp-page"><p class="lp-page-meta">自定义页面</p><h1 class="lp-page-title"><%= page.title %></h1><div class="lp-page-body"><%- html %></div><% if (currentUser) { %><p class="lp-page-edit"><a href="/admin/pages/<%= page.id %>/edit">编辑此页面 →</a></p><% } %></article>